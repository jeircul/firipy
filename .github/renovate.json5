{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>jeircul/renovate-config',
  ],
  customManagers: [
    {
      description: 'Update pinned Python versions referenced in workflows',
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/.*\\.yml$/',
      ],
      matchStrings: [
        "python install (?<currentValue>\\d+\\.\\d+)",
        "Python (?<currentValue>\\d+\\.\\d+)\\)",
      ],
      depNameTemplate: 'python',
      datasourceTemplate: 'python-version',
    },
  ],
}
